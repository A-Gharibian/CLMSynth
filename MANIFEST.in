# Top-level project metadata and reference material
include README.md
include CHANGELOG.md
include CITATION.cff
include codemeta.json
include LICENSE.txt
include SECURITY.md
include requirements.txt
include environment.yml

# Example configs referenced by the README quick-start.
include upstream_payload.yaml

# User manual and the coded-diagnostics reference catalogue.
# The .csv is for docs/troubleshooting_catalog/_data
recursive-include docs *.tex
recursive-include docs *.yaml
recursive-include docs *.log
recursive-include docs *.csv
recursive-include docs *.pdf

# Planning and design notes.
include docs/engine_internals.md
include docs/ROADMAP.md

# What the test modules check.
include docs/TESTING.md

# Package source
recursive-include src/clmsynth *.py
recursive-include src/clmsynth *.json
include src/clmsynth/py.typed

# Never ship build/tooling
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
prune src/clmsynth.egg-info
prune .venv
prune .idea
prune Inspection
prune tests
prune ignore
prune build
prune dist
