# MANIFEST.in -- controls what ships in the sdist (the .tar.gz built by
# `python -m build`), on top of whatever setuptools auto-includes for the
# discovered `clmsynth` package. Wheel/package contents are governed
# separately by [tool.setuptools.packages.find] in pyproject.toml; this file
# only affects the source distribution.

# Top-level project metadata and reference material
include README.md
include CHANGELOG.md
include CITATION.cff
include codemeta.json
include LICENSE.txt
include SECURITY.md
include requirements.txt
include environment.yml

# Example configs referenced by the README quick-start. The offline one moved
# into the package, so `recursive-include src/clmsynth *.yaml` below carries it.
include upstream_payload.yaml

# User manual and the coded-diagnostics reference catalogue.
# The .csv is for docs/troubleshooting_catalog/_data
recursive-include docs *.tex
recursive-include docs *.yaml
recursive-include docs *.log
recursive-include docs *.csv
recursive-include docs *.pdf

# Planning and design notes.
include docs/troubleshooting_catalog/engine_internals.md
include docs/ROADMAP.md

# Package source (normally auto-included via packages.find for a pure-Python
# package; listed explicitly here for sdist robustness regardless of build
# backend behavior).
recursive-include src/clmsynth *.py
recursive-include src/clmsynth *.yaml

# Never ship build/tooling
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
prune src/clmsynth.egg-info
prune .venv
prune .idea
prune Inspection
prune tests
prune ignore
prune build
prune dist
